# Deployer wallet used by the CLI (tapeout / processor create / publish). Never commit .env.
PRIVATE_KEY=0x...
XLAYER_RPC=https://rpc.xlayer.tech
# API used by `tapesynth synth --remote`
TAPESYNTH_API=https://tapesynth-api.fly.dev

# API server only
TREASURY_ADDRESS=0x...
PRO_JOB_PRICE_WEI=5000000000000000
DB_PATH=/data/tapesynth.db
PORT=8080
SYNTH_CONCURRENCY=2
